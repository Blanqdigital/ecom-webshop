# =============================================================================
# ecom-webshop — environment template
# Copy to .env.local for local dev:  cp .env.example .env.local
# Paste the same keys into Vercel (or your host) for production.
# Everything is optional until you enable that integration — checkout needs
# Stripe + Supabase at minimum. Never commit real secrets.
# =============================================================================

# --- Site ---
# Public base URL (Stripe success/cancel, emails, crons). Falls back to the
# request origin when unset, so optional in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe ---
# Dashboard → Developers → API keys. Use test keys locally.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret (checkout.session.completed + payment_intent.succeeded).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Supabase ---
# Project Settings → API. Service-role is server-only — never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
# Comma-separated emails allowed into /admin (must match a Supabase Auth user).
ADMIN_EMAILS=hei@yourshop.example

# --- Vipps (optional) ---
# portal.vippsmobilepay.com → Developer. No-ops until all four + flag are set.
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
# "test" (apitest.vipps.no) or "production" (api.vipps.no).
VIPPS_ENV=test
# Show "Betal med Vipps" at /kasse. NEXT_PUBLIC_* is build-time — redeploy to toggle.
NEXT_PUBLIC_VIPPS_ENABLED=

# --- Email / Resend (optional) ---
RESEND_API_KEY=
# Verified sender, e.g. "YOUR BRAND <ordre@yourshop.example>".
ORDER_FROM=
# New-order alerts. Defaults to company support email when unset.
ORDER_NOTIFY_TO=

# --- Telegram order notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Crons (abandoned cart + weekly report) ---
# Long random string. GitHub Actions / schedulers send Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Optional: when the current sale ends (ISO 8601). Unset = always live.
SALE_ENDS_AT=
# Optional: signs one-click unsubscribe links. Falls back to CRON_SECRET.
EMAIL_UNSUB_SECRET=

# --- BLANQ dashboard metrics feed (optional) ---
# Bearer token for read-only /api/metrics.
BLANQ_METRICS_TOKEN=

# --- Shopify fulfilment / dropship (optional) ---
# Custom-app Admin API token (write_orders + read_products). No-ops until set.
# Fill SHOPIFY_VARIANT_MAP in src/lib/shopify.ts after import (match by image).
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# --- Tracking overrides (optional) ---
# Prefer pasting IDs in /admin → Settings (stored in DB, no redeploy).
# These env vars hard-override the DB when set.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_CLARITY_ID=
# Clarity Data Export API — powers /admin → Insights Clarity panel + .mcp.json.
CLARITY_API_TOKEN=

# --- Meta Conversions API (optional) ---
# Server-side events; no-ops until set. Pixel ID still comes from admin/env above.
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager "Test events" code while validating.
META_CAPI_TEST_EVENT_CODE=

# --- Google Search Console (optional) ---
# HTML-tag verification content token only (not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=
