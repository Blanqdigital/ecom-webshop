# =============================================================================
# ecom-webshop — environment template
# Copy to .env.local for local dev:  cp .env.example .env.local
# Paste bootstrap keys into Vercel (or your host) for production.
# Prefer Admin → Integrations for store secrets after first deploy.
# Never commit real secrets.
# =============================================================================

# --- Bootstrap (required in host env — NOT moved to Admin → Integrations) ---
# Public base URL (Stripe success/cancel, emails, crons). Falls back to the
# request origin when unset, so optional in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API. Service-role is server-only — never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into /admin (must match a Supabase Auth user).
ADMIN_EMAILS=hei@yourshop.example

# Long random string. GitHub Actions / schedulers send Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Stripe webhook signing secret (checkout.session.completed + payment_intent.succeeded).
# Stays in env — not editable from admin (webhook verification bootstrap).
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: signs one-click unsubscribe links. Falls back to CRON_SECRET.
EMAIL_UNSUB_SECRET=

# Optional: Bearer token for read-only /api/metrics.
BLANQ_METRICS_TOKEN=

# --- Prefer Admin → Integrations (env still wins as hard override) ---
# After deploy with Supabase + ADMIN_EMAILS, paste these in /admin → Integrations.
# Leaving them here locks the admin fields (ops override).

# Stripe API keys (secret + publishable). Webhook secret stays above.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Vipps — portal.vippsmobilepay.com → Developer.
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
# "test" (apitest.vipps.no) or "production" (api.vipps.no).
VIPPS_ENV=test
# Show "Betal med Vipps" at /kasse. Prefer Admin toggle (no redeploy).
NEXT_PUBLIC_VIPPS_ENABLED=

# Email / Resend
RESEND_API_KEY=
# Verified sender, e.g. "YOUR BRAND <ordre@yourshop.example>".
ORDER_FROM=
# New-order alerts. Defaults to company support email when unset.
ORDER_NOTIFY_TO=

# Telegram order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: when the current sale ends (ISO 8601). Unset = always live.
SALE_ENDS_AT=

# Shopify fulfilment / dropship
# Fill SHOPIFY_VARIANT_MAP in src/lib/shopify.ts after import (match by image).
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify webhook HMAC (custom app API secret). Also editable in Admin → Integrations.
# Falls back to SHOPIFY_API_SECRET when unset.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_SECRET=

# Signed /ordre/<token> links in emails. Falls back to EMAIL_UNSUB_SECRET / CRON_SECRET.
ORDER_TOKEN_SECRET=

# Signed post-purchase (/tilbud) offer tokens. Falls back to ORDER_TOKEN_SECRET chain.
POST_PURCHASE_TOKEN_SECRET=

# Meta Conversions API
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# Clarity Data Export API — Insights panel
CLARITY_API_TOKEN=

# --- Tracking overrides (optional) ---
# Prefer pasting IDs in /admin → Settings (stored in DB, no redeploy).
# These env vars hard-override the DB when set.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Google Search Console (optional) ---
# HTML-tag verification content token only (not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=
